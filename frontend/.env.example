VITE_API_BASE_URL=http://localhost:8000

# Engine hiatus mode. Set to "true" in the Vercel Production environment
# during the offline transition to grey out Find-a-Show + Shows-Like-This
# tabs and show a hiatus notice. Leave unset locally so `npm run dev` keeps
# full engine functionality. Encyclopedia + all static anime pages stay
# fully interactive in either state.
# VITE_ENGINE_HIATUS_MODE=true

# Rollback for the Find-a-Show title-lookup hint (COA A, 2026-08-26). When
# a user's FaS query is an exact show title in the vault, a yellow hint
# offers an Encyclopedia lookup. Set to "false" to disable site-wide.
# Enabled by default.
# VITE_FAS_TITLE_HINT_ENABLED=false
